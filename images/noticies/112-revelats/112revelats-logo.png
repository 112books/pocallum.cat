		<style type="text/css" id="wp-custom-css">
			/* ==========================
   RESET I AJUSTOS GENERALS
========================== */
body {
    font-family: "Ubuntu", sans-serif;
    font-size: 18px; /* cos de text més llegible */
    line-height: 1.6;
    color: #222;
}

p, li {
    font-size: 1rem;
    line-height: 1.6;
}

.wp-block-heading {
    margin-top: 1em;
    margin-bottom: 0.5em;
}

/* ==========================
   TÍTOLS PRINCIPALS
========================== */
.page-header .entry-title,
.page-header .page-title {
    text-transform: none;
    font-family: "Ubuntu", sans-serif;
    font-weight: 700; /* bold */
    text-align: left; /* alineació esquerra */
    font-size: 4em;
    margin: 0.5em 0;
}

/* H2 / H3 */
h2.wp-block-heading, h3.wp-block-heading {
    text-transform: none;
    font-family: "Ubuntu", sans-serif;
    font-weight: 700;
    letter-spacing: normal;
    word-spacing: normal;
    text-align: left;
}

h2.wp-block-heading {
    font-size: 2.5em;
}

h3.wp-block-heading {
    font-size: 1.8em;
}

/* ==========================
   BOTONS
========================== */
.btn {
    text-transform: none;
}

/* ==========================
   MENÚ PRINCIPAL
========================== */
.onepress-menu {
    padding-top: 1.5em;
    padding-bottom: 1.5em;
    display: flex;
    justify-content: flex-start;
}

.onepress-menu a {
    text-transform: none;
    font-size: 1.2em;
    line-height: 1.5;
}

.onepress-menu ul li a {
    font-size: 1.1em;
    line-height: 1.6;
}

/* Menú responsive: tauleta i mòbil */
@media (max-width: 1024px) {
    .onepress-menu {
        display: none; /* menú gran desapareix */
    }
}

/* ==========================
   HERO / HEADER
========================== */
.hero-content-style1 h2,
.section-title-area .section-subtitle,
.section-title-area .section-title,
.section-news .list-article-meta,
.archive .list-article-meta,
.blog .list-article-meta {
    text-transform: none;
}

/* ==========================
   CONTENIT / BLOCS
========================== */
#post-1411 .has-text-align-center,
#post-1445 .has-text-align-center,
#post-1446 .has-text-align-center  {
    height: 300px;
    border: none;
}

.post-1411 table,
.post-1445 table,
.post-1446 table {
    border: none!important;
}

/* ==========================
   TAULES
========================== */
table {
    border-collapse: collapse;
}

table, th, td {
    border: none;
}

/* ==========================
   ESPAIS I LÍNIES
========================== */
.wp-block-heading {
    margin-top: 1em;
    margin-bottom: 0.5em;
}

p {
    margin-bottom: 1em;
}

/* ==========================
   TÍTOLS ADAPTATIUS
========================== */
@media (max-width: 1200px) {
    .page-header .entry-title,
    .page-header .page-title {
        font-size: 3.5em;
    }
    h2.wp-block-heading {
        font-size: 2.2em;
    }
    h3.wp-block-heading {
        font-size: 1.6em;
    }
}

@media (max-width: 992px) {
    .page-header .entry-title,
    .page-header .page-title {
        font-size: 3em;
    }
    h2.wp-block-heading {
        font-size: 2em;
    }
    h3.wp-block-heading {
        font-size: 1.5em;
    }
}

@media (max-width: 768px) {
    .page-header .entry-title,
    .page-header .page-title {
        font-size: 2.5em;
    }
    h2.wp-block-heading {
        font-size: 1.8em;
    }
    h3.wp-block-heading {
        font-size: 1.3em;
    }
    body {
        font-size: 16px;
    }
}

@media (max-width: 480px) {
    .page-header .entry-title,
    .page-header .page-title {
        font-size: 2em;
    }
    h2.wp-block-heading {
        font-size: 1.6em;
    }
    h3.wp-block-heading {
        font-size: 1.2em;
    }
    body {
        font-size: 15px;
    }
}

/* ==========================
   ESCAPAMENT / ESPAI ENTRE ELEMENTS
========================== */
.section-title-area,
.hero-content-style1 {
    margin-bottom: 2em;
}

.onepress-menu ul li {
    margin-bottom: 0.3em; /* més espai vertical al submenu */
}

/* ==========================
   AJUSTOS FINAL
========================== */
.page-header {
    background: none;
    padding: 3em 2em;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}


