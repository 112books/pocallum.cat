# ──────────────────────────────────────────────────────────────
#  Pocallum — headers de seguretat (Dinahosting / Apache)
#  Convertit des de static/_headers (que era per GitHub Pages).
#  ⚠️ NO posar cap redirect HTTP→HTTPS aquí: el proxy de
#  Dinahosting ho gestiona des del panell (Forçar HTTPS).
#  Un redirect a .htaccess provocaria un loop infinit.
# ──────────────────────────────────────────────────────────────

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' gc.zgo.at; connect-src 'self' *.goatcounter.com https://vimeo.com https://*.vimeo.com; frame-src tally.so *.tally.so https://player.vimeo.com; img-src 'self' data: https://i.vimeocdn.com; style-src 'self'; font-src 'self'"

  # HTML/XML: revalida sempre (res de cache sense comprovar)
  <FilesMatch "\.(html?|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS/JS (noms amb hash): cache 1 any immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imatges i fonts: cache 30 dies
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|ico|woff2?|svg|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>