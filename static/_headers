/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' gc.zgo.at; connect-src 'self' *.goatcounter.com; frame-src tally.so *.tally.so; img-src 'self' data:; style-src 'self'; font-src 'self'

# CMS (Sveltia) — CSP específica, replica el .htaccess de static/admin/
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; connect-src 'self' blob: data: https://unpkg.com https://api.github.com https://www.githubstatus.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' blob: data: https://avatars.githubusercontent.com https://*.githubusercontent.com; frame-src 'self' blob:; frame-ancestors 'self'; manifest-src blob:
